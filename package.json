{
  "name": "yt-dlp-client",
  "version": "1.0.1",
  "description": "A modern desktop GUI client for yt-dlp",
  "author": "D1verlin <d1verlin@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/D1verlin/YT-DLP-Client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/D1verlin/YT-DLP-Client.git"
  },
  "keywords": [
    "yt-dlp",
    "youtube-dl",
    "video-downloader",
    "electron",
    "react",
    "desktop-app",
    "media-downloader"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && node scripts/builder.cjs --dir",
    "dist": "npm run build && node scripts/builder.cjs",
    "dist:win": "npm run build && node scripts/builder.cjs --win",
    "dist:linux": "npm run build && node scripts/builder.cjs --linux",
    "dist:all": "npm run build && node scripts/builder.cjs -wl",
    "release": "npm run build && node scripts/builder.cjs --publish always",
    "release:win": "npm run build && node scripts/builder.cjs --win --publish always",
    "release:linux": "npm run build && node scripts/builder.cjs --linux --publish always"
  },
  "dependencies": {
    "electron-store": "^7.0.3",
    "lucide-react": "^0.400.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
